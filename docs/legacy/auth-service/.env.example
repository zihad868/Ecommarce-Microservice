NODE_ENV=development
PORT=3001
GRPC_PORT=50051
DATABASE_URL=postgresql://auth_user:CHANGE_ME@localhost:5433/auth_db?schema=public
# Must be at least 32 characters. Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_at_least_32_chars_long_jwt_secret_here_xxxx
JWT_REFRESH_SECRET=CHANGE_ME_at_least_32_chars_long_refresh_secret_xx
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REDIS_HOST=localhost
REDIS_PORT=6379
CORS_ORIGIN=http://localhost:3000

{
  "name": "ecommerce",
  "version": "1.0.0",
  "description": "Production-grade e-commerce microservice system",
  "private": true,
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "packages/*",
    "edge/*",
    "services/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md,yml,yaml}\"",
    "db:generate": "npm run db:generate --workspace identity-service --workspace catalog-service --workspace order-service",
    "db:migrate": "npm run db:migrate --workspace identity-service --workspace catalog-service --workspace order-service",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "prepare": "husky",
    "db:push": "npm run db:push --workspace identity-service --workspace catalog-service --workspace order-service",
    "contracts:generate": "node tools/codegen.mjs",
    "contracts:check": "node tools/check-contracts.mjs",
    "contracts:lint": "buf lint contracts",
    "contracts:breaking": "buf breaking contracts --against .git#branch=main,subdir=contracts",
    "check": "npm run contracts:check && npm run lint && npm run typecheck",
    "dev:gateway": "npm run dev --workspace api-gateway"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.50.0",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.18.0",
    "@grpc/proto-loader": "^0.8.1",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.0"
  },
  "lint-staged": {
    "*.ts": [
      "npm exec -- eslint --fix",
      "npm exec -- prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "npm exec -- prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "helmet": "^8.3.0",
    "prisma": "6.19.3",
    "rate-limit-redis": "^6.0.1",
    "zod": "^3.24.2"
  }
}

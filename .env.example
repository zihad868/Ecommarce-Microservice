# -----------------------------------------------------------------
# ECOMMERCE MICROSERVICE — Environment Variables
# Copy this file to .env and fill in real secrets.
# NEVER commit .env to source control.
# -----------------------------------------------------------------

# -- Auth Service -------------------------------------------------
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=CHANGE_ME_strong_auth_db_password
AUTH_DB_NAME=auth_db

# Must be at least 32 characters. Generate: openssl rand -hex 32
JWT_PRIVATE_KEY="REPLACE_WITH_RS256_PRIVATE_PEM_WITH_ESCAPED_NEWLINES"
JWT_PUBLIC_KEY="REPLACE_WITH_RS256_PUBLIC_PEM_WITH_ESCAPED_NEWLINES"

# -- Order Service ------------------------------------------------
ORDER_DB_USER=order_user
ORDER_DB_PASSWORD=CHANGE_ME_strong_order_db_password
ORDER_DB_NAME=order_db

# -- Product Service ----------------------------------------------
PRODUCT_DB_USER=product_user
PRODUCT_DB_PASSWORD=CHANGE_ME_strong_product_db_password
PRODUCT_DB_NAME=product_db

# -- Observability ------------------------------------------------
# Grafana admin password - use a strong password, not 'admin'
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_strong_grafana_password

# Optional in Compose with --profile observability. Leave unset to disable tracing.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

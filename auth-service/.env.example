NODE_ENV=development
PORT=3001
GRPC_PORT=50051
DATABASE_URL=postgresql://auth_user:auth_password@localhost:5433/auth_db?schema=public
# Must be at least 32 characters
JWT_SECRET=supersecret123_change_in_production_32chars_min
JWT_REFRESH_SECRET=supersecretrefresh123_change_in_prod_32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REDIS_HOST=localhost
REDIS_PORT=6379
CORS_ORIGIN=http://localhost:3000

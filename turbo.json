{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["contracts/**", "tsconfig.base.json", "tools/copy-prisma-client.mjs"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", "src/generated/client/**", "$TURBO_ROOT$/tsconfig.base.json"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
